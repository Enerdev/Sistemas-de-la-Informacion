{
  "name": "simona-bn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @simona-bn/api",
    "dev:web": "npm run dev --workspace @simona-bn/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @simona-bn/api",
    "db:migrate": "npm run db:migrate --workspace @simona-bn/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @simona-bn/api",
    "db:seed": "npm run db:seed --workspace @simona-bn/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.2"
  }
}
