generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum ChannelType {
  APP
  INTERNET_BANKING
  MULTIRED_VIRTUAL
}

enum ChannelStatus {
  UNKNOWN
  AVAILABLE
  DEGRADED
  UNAVAILABLE
  MAINTENANCE
}

enum CheckResult {
  SUCCESS
  DEGRADED
  FAILURE
  TIMEOUT
}

enum CheckSource {
  SIMULATED
  HTTP
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentEventKind {
  OPENED
  STATUS_CHANGED
  CHANNEL_RECOVERED
}

enum IncidentActorType {
  USER
  SYSTEM
}

enum ChannelStatusChangeSource {
  USER
  CHECK
  SYSTEM
}

enum NotificationKind {
  CHANNEL_DOWN
  CHANNEL_RECOVERED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum FailureReportStatus {
  NEW
  REVIEWED
  LINKED
  DISMISSED
}

model User {
  id                   String                  @id @default(uuid()) @db.Uuid
  email                String                  @unique @db.VarChar(254)
  passwordHash         String                  @db.VarChar(255)
  role                 UserRole                @default(VIEWER)
  active               Boolean                 @default(true)
  mustChangePassword   Boolean                 @default(false)
  lastLoginAt          DateTime?
  sessions             Session[]
  incidentEvents       IncidentEvent[]
  channelStatusChanges ChannelStatusHistory[]
  reviewedReports      FailureReport[]
  scheduleImports      PaymentScheduleImport[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Channel {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String                 @unique @db.VarChar(40)
  name              String                 @db.VarChar(120)
  description       String?                @db.VarChar(500)
  type              ChannelType
  simulatedTarget   String                 @db.VarChar(200)
  currentStatus     ChannelStatus          @default(UNKNOWN)
  monitoringEnabled Boolean                @default(false)
  monitoringConfig  MonitoringConfig?
  checks            ChannelCheck[]
  incidents         Incident[]
  statusHistory     ChannelStatusHistory[]
  notifications     Notification[]
  failureReports    FailureReport[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([monitoringEnabled, currentStatus])
  @@map("channels")
}

model MonitoringConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  channelId            String   @unique @db.Uuid
  checkIntervalSeconds Int      @default(60)
  timeoutMillis        Int      @default(5000)
  latencyWarningMillis Int      @default(1500)
  failureThreshold     Int      @default(3)
  recoveryThreshold    Int      @default(2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  channel              Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("monitoring_configs")
}

model ChannelCheck {
  id                String          @id @default(uuid()) @db.Uuid
  channelId         String          @db.Uuid
  source            CheckSource     @default(SIMULATED)
  result            CheckResult
  observedStatus    ChannelStatus
  responseTimeMs    Int?
  httpStatusCode    Int?
  detail            String?         @db.VarChar(500)
  checkedAt         DateTime        @default(now())
  channel           Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  detectedIncidents Incident[]      @relation("IncidentDetection")
  incidentEvents    IncidentEvent[]

  @@index([channelId, checkedAt])
  @@index([checkedAt])
  @@map("channel_checks")
}

model Incident {
  id               String           @id @default(uuid()) @db.Uuid
  channelId        String           @db.Uuid
  detectionCheckId String?          @db.Uuid
  status           IncidentStatus   @default(OPEN)
  severity         IncidentSeverity @default(MEDIUM)
  summary          String           @db.VarChar(240)
  reason           String           @db.VarChar(500)
  evidence         String           @db.VarChar(2000)
  startedAt        DateTime?
  detectedAt       DateTime         @default(now())
  openedAt         DateTime         @default(now())
  recoveredAt      DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  channel          Channel          @relation(fields: [channelId], references: [id], onDelete: Restrict)
  detectionCheck   ChannelCheck?    @relation("IncidentDetection", fields: [detectionCheckId], references: [id], onDelete: SetNull)
  events           IncidentEvent[]
  notifications    Notification[]
  failureReports   FailureReport[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([channelId, status])
  @@index([status, openedAt])
  @@index([channelId, detectedAt])
  @@index([detectionCheckId])
  @@map("incidents")
}

model IncidentEvent {
  id             String            @id @default(uuid()) @db.Uuid
  incidentId     String            @db.Uuid
  checkId        String?           @db.Uuid
  actorId        String?           @db.Uuid
  actorType      IncidentActorType
  kind           IncidentEventKind @default(STATUS_CHANGED)
  previousStatus IncidentStatus?
  newStatus      IncidentStatus
  note           String?           @db.VarChar(500)
  createdAt      DateTime          @default(now())
  incident       Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  check          ChannelCheck?     @relation(fields: [checkId], references: [id], onDelete: SetNull)
  actor          User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([checkId])
  @@index([actorId])
  @@map("incident_events")
}

model ChannelStatusHistory {
  id             String                    @id @default(uuid()) @db.Uuid
  channelId      String                    @db.Uuid
  actorId        String?                   @db.Uuid
  previousStatus ChannelStatus?
  newStatus      ChannelStatus
  source         ChannelStatusChangeSource
  changedAt      DateTime                  @default(now())
  channel        Channel                   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  actor          User?                     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([channelId, changedAt])
  @@index([actorId])
  @@map("channel_status_history")
}

model NotificationRecipient {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique @db.VarChar(254)
  name           String?        @db.VarChar(120)
  active         Boolean        @default(true)
  notifyDown     Boolean        @default(true)
  notifyRecovery Boolean        @default(true)
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("notification_recipients")
}

model Notification {
  id                String                 @id @default(uuid()) @db.Uuid
  kind              NotificationKind
  status            NotificationStatus     @default(PENDING)
  channelId         String                 @db.Uuid
  incidentId        String?                @db.Uuid
  recipientId       String?                @db.Uuid
  recipientEmail    String                 @db.VarChar(254)
  subject           String                 @db.VarChar(200)
  body              String                 @db.VarChar(4000)
  eventAt           DateTime
  attempts          Int                    @default(0)
  maxAttempts       Int                    @default(3)
  nextAttemptAt     DateTime               @default(now())
  lastError         String?                @db.VarChar(500)
  providerMessageId String?                @db.VarChar(255)
  previewUrl        String?                @db.VarChar(500)
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  channel           Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  incident          Incident?              @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  recipient         NotificationRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([incidentId])
  @@index([channelId, createdAt])
  @@index([recipientId])
  @@map("notifications")
}

model FailureReport {
  id            String              @id @default(uuid()) @db.Uuid
  referenceCode String              @unique @db.VarChar(16)
  channelId     String              @db.Uuid
  incidentId    String?             @db.Uuid
  reviewedById  String?             @db.Uuid
  status        FailureReportStatus @default(NEW)
  description   String              @db.VarChar(1000)
  contactEmail  String?             @db.VarChar(254)
  occurredAt    DateTime?
  reviewNote    String?             @db.VarChar(500)
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  channel       Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  incident      Incident?           @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  reviewedBy    User?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([channelId, createdAt])
  @@index([incidentId])
  @@map("failure_reports")
}

model PaymentScheduleImport {
  id           String        @id @default(uuid()) @db.Uuid
  fileName     String        @db.VarChar(200)
  rowCount     Int
  createdCount Int
  updatedCount Int
  importedById String?       @db.Uuid
  importedAt   DateTime      @default(now())
  importedBy   User?         @relation(fields: [importedById], references: [id], onDelete: SetNull)
  paymentDates PaymentDate[]

  @@index([importedAt])
  @@map("payment_schedule_imports")
}

model PaymentDate {
  id          String                 @id @default(uuid()) @db.Uuid
  date        DateTime               @db.Date
  group       String                 @db.VarChar(60)
  description String?                @db.VarChar(200)
  importId    String?                @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  import      PaymentScheduleImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([date, group])
  @@index([date])
  @@map("payment_dates")
}

// Bitácora de solo inserción: un disparador en PostgreSQL impide modificar o borrar filas.
// No tiene clave foránea a usuarios para que borrar un usuario no altere el registro histórico.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorEmail String?  @db.VarChar(254)
  actorRole  String?  @db.VarChar(20)
  action     String   @db.VarChar(60)
  entityType String   @db.VarChar(40)
  entityId   String?  @db.VarChar(64)
  summary    String   @db.VarChar(500)
  details    Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
