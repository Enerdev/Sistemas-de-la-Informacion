NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://simona:change-me@localhost:5432/simona_bn?schema=public
# Optional, development-only bootstrap. Supply both values locally; never commit them.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
# simulated is offline and safe by default. For HTTP, configure exact authorities
# (hostname[:port]) explicitly. Only HTTPS requests are accepted and redirects are disabled.
MONITORING_DRIVER=simulated
# MONITORING_HTTP_ALLOWED_HOSTS=health.example.edu
# Set only to run database integration tests. It must target a local *_test database.
# TEST_DATABASE_URL=postgresql://simona:change-me@localhost:5432/simona_bn_test?schema=public
