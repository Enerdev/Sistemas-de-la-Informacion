NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://simona:change-me@localhost:5432/simona_bn?schema=public
# Optional, development-only bootstrap. Supply both values locally; never commit them.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
# simulated is offline and safe by default. For HTTP, configure exact authorities
# (hostname[:port]) explicitly. Only HTTPS requests are accepted and redirects are disabled.
MONITORING_DRIVER=simulated
# MONITORING_HTTP_ALLOWED_HOSTS=health.example.edu
# M3 notificaciones: json (sin red, predeterminado), ethereal (buzón SMTP de prueba) o smtp.
NOTIFICATIONS_DRIVER=json
# NOTIFICATIONS_FROM=SIMONA-BN <alertas@simona.test>
# Solo para smtp (y opcional para fijar una cuenta ethereal). Nunca subas credenciales reales.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Intentos de inicio de sesión por IP cada 15 minutos (las pruebas lo elevan automáticamente).
# LOGIN_RATE_LIMIT_MAX=10
# Respaldos: carpeta y cantidad que se conserva (scripts/db/backup.sh).
# BACKUP_DIR=./backups
# BACKUP_RETENTION=14
# Set only to run database integration tests. It must target a local *_test database.
# TEST_DATABASE_URL=postgresql://simona:change-me@localhost:5432/simona_bn_test?schema=public
